      "beat": 1,
      "file_start": 12.953,
      "start": 12.953,
      "end": 17.329,
      "volume": 0.22,
      "pan": 0.6
    },
    {
      "id": "M05",
      "speaker": "FAHRGAST_A",
      "text": "Hat jemand Empfang? Ich hab gar keinen.",
