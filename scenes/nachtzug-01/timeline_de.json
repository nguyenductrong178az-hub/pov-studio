      "file_start": 26.83,
      "start": 26.83,
      "end": 30.182,
      "volume": 0.22,
      "pan": 0.6
    },
    {
      "id": "M07",
      "speaker": "FAHRGAST_C",
      "text": "Das kam doch letztens in den Nachrichten.",
