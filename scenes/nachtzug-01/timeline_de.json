      "beat": 1,
      "file_start": 18.168,
      "start": 18.329,
      "end": 21.524,
      "volume": 0.22,
      "pan": -0.6
    },
    {
      "id": "M06",
      "speaker": "FAHRGAST_B",
      "text": "Kabel klauen? Ernsthaft? Hier draußen?",
