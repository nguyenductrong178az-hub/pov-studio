      "file_start": 31.182,
      "start": 31.182,
      "end": 33.768,
      "volume": 0.22,
      "pan": -0.6
    },
    {
      "id": "M08",
      "speaker": "FAHRGAST_D",
      "text": "Und wir sitzen hier fest. Na toll.",
